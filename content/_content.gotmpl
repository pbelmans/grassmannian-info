{{ range hugo.Data.catalog.records }}
  {{ $title := .name | default (strings.TrimPrefix "/" .route) }}
  {{ $weight := 0 }}
  {{ $aliases := slice }}
  {{ if eq .route "/A1/1" }}{{ $aliases = slice "/B1/1/" "/C1/1/" }}{{ end }}
  {{ if eq .family "Dynkin type" }}{{ $weight = int .invariants.rank }}{{ end }}
  {{ $.AddPage (dict
    "path" (strings.TrimPrefix "/" .route)
    "url" (printf "%s/" .route)
    "kind" .kind
    "title" $title
    "weight" $weight
    "aliases" $aliases
    "layout" "record"
    "params" (dict "record_route" .route "family" .family)
  ) }}
{{ end }}
{{ .AddPage (dict "path" "horospherical" "kind" "section" "title" "Horospherical varieties" "layout" "record" "params" (dict "record_route" "/horospherical")) }}
{{ range $route, $title := dict "projective-duality" "Projective duality" "freudenthal" "The Freudenthal magic square" "vogel" "The Vogel plane" "references" "References" "about" "About" "explained" "Explained" }}
  {{ $.AddPage (dict "path" $route "title" $title "layout" "record" "params" (dict "record_route" (printf "/%s" $route))) }}
{{ end }}
